___TESTS___

scenarios:
- name: Base code loads acro.js for the write key
  code: |-
    runCode({ writeKey: 'acro_pk_test123', eventType: 'pageView' });
    assertThat(injected).isEqualTo(['https://t.acro.sh/s/acro_pk_test123.js']);
    assertApi('createQueue').wasNotCalled();
    assertApi('callInWindow').wasNotCalled();
    assertApi('gtmOnSuccess').wasCalled();
- name: An invalid write key fails the tag
  code: |-
    runCode({ writeKey: 'not-a-key', eventType: 'pageView' });
    assertApi('injectScript').wasNotCalled();
    assertApi('gtmOnFailure').wasCalled();
- name: Purchase is queued before acro.js loads
  code: |-
    runCode({
      writeKey: 'acro_pk_test123',
      eventType: 'standard',
      standardEvent: 'purchase',
      value: '39000',
      currency: 'KRW',
      orderId: 'order-1',
      items: [{ id: 'sku-1', name: 'Tee', category: 'Apparel', price: 39000, quantity: 1 }],
      properties: [{ name: 'coupon', value: 'WELCOME' }],
    });
    assertThat(queued).isEqualTo([
      ['purchase', {
        coupon: 'WELCOME',
        value: '39000',
        currency: 'KRW',
        orderId: 'order-1',
        items: [{ id: 'sku-1', name: 'Tee', category: 'Apparel', price: 39000, quantity: 1 }],
      }],
    ]);
    assertApi('gtmOnSuccess').wasCalled();
- name: The GA4 ecommerce object fills a purchase, tag fields win
  code: |-
    mock('copyFromDataLayer', (key) => key === 'ecommerce' ? {
      transaction_id: 'T-1',
      value: 25.5,
      currency: 'USD',
      items: [{ item_id: 'sku-2', item_name: 'Mug', item_category: 'Home', price: 12.75, quantity: 2 }],
    } : undefined);
    runCode({
      writeKey: 'acro_pk_test123',
      eventType: 'standard',
      standardEvent: 'purchase',
      useEcommerce: true,
      currency: 'EUR',
    });
    assertThat(queued).isEqualTo([
      ['purchase', {
        value: 25.5,
        currency: 'EUR',
        orderId: 'T-1',
        items: [{ id: 'sku-2', name: 'Mug', category: 'Home', price: 12.75, quantity: 2 }],
      }],
    ]);
- name: A custom event goes straight to a loaded pixel
  code: |-
    mock('copyFromWindow', (key) => key === 'acro' ? { push: () => {} } : undefined);
    runCode({
      writeKey: 'acro_pk_test123',
      eventType: 'custom',
      eventName: 'Quiz Completed',
      properties: [{ name: 'score', value: 7 }],
    });
    assertApi('callInWindow').wasCalledWith('acro.push', ['track', 'Quiz Completed', { score: 7 }]);
    assertApi('createQueue').wasNotCalled();
- name: Identify sends the user ID and traits
  code: |-
    runCode({
      writeKey: 'acro_pk_test123',
      eventType: 'identify',
      userId: 'user-1',
      traits: [{ name: 'plan', value: 'pro' }],
    });
    assertThat(queued).isEqualTo([['identify', 'user-1', { plan: 'pro' }]]);
- name: Identify without a user ID sends nothing
  code: |-
    runCode({ writeKey: 'acro_pk_test123', eventType: 'identify', userId: '' });
    assertThat(queued).isEqualTo([]);
    assertApi('injectScript').wasCalled();
- name: Reset is queued
  code: |-
    runCode({ writeKey: 'acro_pk_test123', eventType: 'reset' });
    assertThat(queued).isEqualTo([['reset']]);
setup: |-
  const queued = [];
  mock('createQueue', (name) => (call) => queued.push(call));
  mock('copyFromWindow', () => undefined);
  mock('copyFromDataLayer', () => undefined);
  const injected = [];
  mock('injectScript', (url, onSuccess, onFailure, cacheToken) => {
    injected.push(url);
    onSuccess();
  });



___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const callInWindow = require('callInWindow');
const copyFromDataLayer = require('copyFromDataLayer');
const copyFromWindow = require('copyFromWindow');
const createQueue = require('createQueue');
const encodeUriComponent = require('encodeUriComponent');
const getType = require('getType');
const injectScript = require('injectScript');
const logToConsole = require('logToConsole');
const makeTableMap = require('makeTableMap');

const log = (message, value) => logToConsole('[Acro] ' + message, value);

const writeKey = (data.writeKey || '').trim();
if (!writeKey.match('^acro_pk_[A-Za-z0-9]+$')) {
  log('Invalid write key', writeKey);
  data.gtmOnFailure();
  return;
}

// Until acro.js loads, window.acro is the queue it replays; afterwards it is
// the pixel itself, whose push() runs a call at once.
const send = (call) => {
  log('Call', call);
  if (getType(copyFromWindow('acro')) === 'object') {
    callInWindow('acro.push', call);
  } else {
    createQueue('acro')(call);
  }
};

const isSet = (value) =>
  value !== undefined && value !== null && value !== '';

// Accepts acro.js items and GA4 ecommerce items alike.
const toItem = (item) => {
  if (getType(item) !== 'object') return item;
  return {
    id: isSet(item.id) ? item.id : item.item_id,
    name: isSet(item.name) ? item.name : item.item_name,
    category: isSet(item.category) ? item.category : item.item_category,
    price: item.price,
    quantity: item.quantity,
  };
};
const toItems = (items) =>
  getType(items) === 'array' ? items.map(toItem) : undefined;

const eventProps = () => {
  const props = makeTableMap(data.properties || [], 'name', 'value') || {};
  const put = (key, value) => {
    if (isSet(value)) props[key] = value;
  };
  if (data.useEcommerce) {
    const ecommerce = copyFromDataLayer('ecommerce', 2);
    if (getType(ecommerce) === 'object') {
      put('value', ecommerce.value);
      put('currency', ecommerce.currency);
      put('orderId', ecommerce.transaction_id);
      put('items', toItems(ecommerce.items));
    }
  }
  // Fields set on the tag win over the dataLayer's ecommerce object.
  put('value', data.value);
  put('currency', data.currency);
  put('orderId', data.orderId);
  put('items', toItems(data.items));
  put('email', data.email);
  put('phone', data.phone);
  return props;
};

if (data.eventType === 'standard') {
  send([data.standardEvent, eventProps()]);
} else if (data.eventType === 'custom') {
  send(['track', data.eventName, eventProps()]);
} else if (data.eventType === 'identify') {
  if (isSet(data.userId)) {
    const traits = makeTableMap(data.traits || [], 'name', 'value') || {};
    send(['identify', data.userId, traits]);
  }
} else if (data.eventType === 'reset') {
  send(['reset']);
}

// acro.js tracks page views itself (SPA navigations too), so the base code
// only loads it; the cache token keeps every tag on the page to one copy.
injectScript(
  'https://t.acro.sh/s/' + encodeUriComponent(writeKey) + '.js',
  data.gtmOnSuccess,
  data.gtmOnFailure,
  'acro'
);


